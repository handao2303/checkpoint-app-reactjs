# Cloudflare static-assets headers.
# Hashed assets are immutable; HTML + the service worker must revalidate so a
# new deploy is picked up instead of serving stale chunk references.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
