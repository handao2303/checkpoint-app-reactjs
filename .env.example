# Copy to .env.local and fill in. Vite only exposes vars prefixed with VITE_.

# Backend API base URL
VITE_API_URL=http://localhost:8080

# Supabase project (Settings → API)
VITE_SUPABASE_URL=https://[ref].supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Firebase — Firestore comments/notifications/remote logs + Analytics.
# From Firebase Console → Project settings → Your apps → Web app config.
# No Firebase Auth/FCM needed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Observability defaults: enabled unless explicitly set to false.
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_DEBUG=false
VITE_REMOTE_LOG_ENABLED=true
